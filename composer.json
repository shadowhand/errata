{
    "name": "errata/errata",
    "description": "Exceptional error handler for JSON APIs",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "api",
        "api-problem",
        "error",
        "error-handler",
        "error-handling",
        "exception",
        "exception-handler",
        "http",
        "json",
        "middleware",
        "problem",
        "problem-details",
        "problem-json",
        "psr-15",
        "psr-7",
        "rfc9457",
        "throwable"
    ],
    "authors": [
        {
            "name": "Woody Gilk",
            "email": "woody.gilk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.0",
        "php-standard-library/dict": "^6.3",
        "php-standard-library/filesystem": "^6.0",
        "php-standard-library/json": "^6.3",
        "php-standard-library/str": "^6.0",
        "php-standard-library/vec": "^6.3",
        "psr/http-factory": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/hook-installer": "^1.0",
        "carthage-software/mago": "^1.50",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^13.3",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Errata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Errata\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyze": "mago analyze",
        "check": "mago format --check",
        "coverage": "coverage-check build/phpunit/clover.xml 100",
        "fix": [
            "mago lint --fix",
            "mago analyze --fix",
            "mago format"
        ],
        "format": "mago format",
        "lint": "mago lint",
        "phpunit": "phpunit -d memory_limit=4G",
        "test": [
            "@phpunit",
            "@coverage"
        ],
        "verify": [
            "@check",
            "@lint",
            "@analyze",
            "@test"
        ]
    }
}
